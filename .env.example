# Optional local build/test command overrides. The static browser inspector has no runtime env loader.
# MAVFRAME_DUMP=/absolute/path/to/build/mavframe-dump
# MAVFRAME_GLUE_DUMP=/absolute/path/to/build/glue_dump
# WASM_BUILD_SCRIPT=/absolute/path/to/tools/build_wasm.sh

# Python web runtime; mount this path as a private persistent volume outside docs/.
APP_DATA_DIR=/var/lib/product
APP_PUBLIC_ORIGIN=http://127.0.0.1:3003
APP_LOCAL_HTTP=1
# Generate a stable random secret outside Git; required when persistence is enabled.
APP_SESSION_SECRET=
APP_SESSION_TTL_SECONDS=2592000
APP_PASSWORD_AUTH=1
# HTTPS deployment: set an exact https:// origin and APP_LOCAL_HTTP=0.
# Cookies become Secure automatically; forwarded headers are never trusted.
